# Copy to .env locally and fill in values. Never commit .env.
# OpenAI-compatible Chinese provider examples:
# DeepSeek: https://api.deepseek.com/v1 + deepseek-chat
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AGENT_MODEL_MODE=offline

# Optional real PostgreSQL integration; leave empty for Chinook only.
ADVENTUREWORKS_DATABASE_URL=

# B stage1: offline SQL + D12
AGENT_BACKEND_MODE=offline_sql_d12
AGENT_ENABLED_PROFILES=chinook-music
AGENT_SQL_WORKERS=2
AGENT_MAX_INFLIGHT_REQUESTS=8
AGENT_SQL_TIMEOUT_MS=60000
AGENT_RAG_TIMEOUT_MS=5000
AGENT_STARTUP_TIMEOUT_SECONDS=30
AGENT_SHUTDOWN_GRACE_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:5173

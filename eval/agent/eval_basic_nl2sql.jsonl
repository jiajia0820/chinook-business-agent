{"id": "basic-nl2sql-001", "level": "basic", "capability": "single_period_total", "question": "2025年第三季度音频销售额、销量、订单数和购买客户数分别是多少？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount,\nSUM(il.Quantity) AS units_sold, COUNT(DISTINCT i.InvoiceId) AS order_count,\nCOUNT(DISTINCT i.CustomerId) AS customer_count\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate >= '2025-07-01' AND i.InvoiceDate < '2025-10-01';", "gold_result": {"sales_amount": 112.86, "units_sold": 114, "order_count": 21, "customer_count": 19}, "gold_calculation": null, "gold_answer": "2025年第三季度音频销售额为112.86美元，销量114件，订单21张，购买客户19位。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["四个指标均正确", "说明统计范围为2025Q3音频"], "clarification_required": false, "clarification_target": null, "difficulty": "easy", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度音频销售额、销量、订单数和购买客户数分别是多少？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}

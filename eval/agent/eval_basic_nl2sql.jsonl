{"id": "basic-nl2sql-005", "level": "basic", "capability": "order_count", "question": "2025年第三季度有多少张音频订单？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT COUNT(DISTINCT i.InvoiceId) AS order_count\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01';", "gold_result": {"order_count": 21}, "gold_calculation": null, "gold_answer": "2025年第三季度有21张音频订单。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["InvoiceId去重", "不把销量当订单数"], "clarification_required": false, "clarification_target": null, "difficulty": "easy", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度有多少张音频订单？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "basic-nl2sql-006", "level": "basic", "capability": "customer_count", "question": "2025年第三季度有多少位购买音频的客户？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT COUNT(DISTINCT i.CustomerId) AS customer_count\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01';", "gold_result": {"customer_count": 19}, "gold_calculation": null, "gold_answer": "2025年第三季度有19位购买音频的客户。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["CustomerId去重"], "clarification_required": false, "clarification_target": null, "difficulty": "easy", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度有多少位购买音频的客户？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "basic-nl2sql-007", "level": "basic", "capability": "genre_ranking", "question": "2025年第三季度音频销售额最高的三个音乐分类是什么？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track", "Genre"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT g.Name AS genre, ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId JOIN Genre g ON g.GenreId=t.GenreId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nGROUP BY g.GenreId,g.Name ORDER BY sales_amount DESC LIMIT 3;", "gold_result": [{"genre": "Rock", "sales_amount": 47.52}, {"genre": "Metal", "sales_amount": 21.78}, {"genre": "Latin", "sales_amount": 15.84}], "gold_calculation": null, "gold_answer": "前三名为 Rock（47.52美元）、Metal（21.78美元）和 Latin（15.84美元）。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["按销售额降序", "列出金额"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度音频销售额最高的三个音乐分类是什么？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "basic-nl2sql-008", "level": "basic", "capability": "track_ranking", "question": "2025年第三季度销售额最高的五个音频商品及金额是什么？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT t.TrackId,t.Name,ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nGROUP BY t.TrackId,t.Name ORDER BY sales_amount DESC,t.TrackId LIMIT 5;", "gold_result": [{"TrackId": 1786, "Name": "Save The Children", "sales_amount": 0.99}, {"TrackId": 1787, "Name": "You Sure Love To Ball", "sales_amount": 0.99}, {"TrackId": 1789, "Name": "Praise", "sales_amount": 0.99}, {"TrackId": 1791, "Name": "Down Under", "sales_amount": 0.99}, {"TrackId": 1793, "Name": "Be Good Johnny", "sales_amount": 0.99}], "gold_calculation": null, "gold_answer": "返回按TrackId区分的前五个商品及其销售额，排序为销售额降序、TrackId升序。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["保留TrackId", "金额排序正确"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度销售额最高的五个音频商品及金额是什么？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "basic-nl2sql-009", "level": "basic", "capability": "media_breakdown", "question": "2025年第三季度各媒体类型的销售额和销量是多少？", "data_scope": "all_media", "expected_tables": ["Invoice", "InvoiceLine", "Track", "MediaType"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT mt.MediaTypeId,mt.Name,ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount,SUM(il.Quantity) AS units_sold\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId JOIN MediaType mt ON mt.MediaTypeId=t.MediaTypeId\nWHERE i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01' GROUP BY mt.MediaTypeId,mt.Name ORDER BY mt.MediaTypeId;", "gold_result": [{"MediaTypeId": 1, "Name": "MPEG audio file", "sales_amount": 111.87, "units_sold": 113}, {"MediaTypeId": 2, "Name": "Protected AAC audio file", "sales_amount": 0.99, "units_sold": 1}], "gold_calculation": null, "gold_answer": "按 MediaTypeId 分列销售额和销量；音频类型与视频类型分别展示。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["不把视频混入音频", "保留MediaTypeId"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度各媒体类型的销售额和销量是多少？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "basic-nl2sql-010", "level": "basic", "capability": "billing_country_ranking", "question": "2025年第三季度音频销售额最高的五个账单国家是什么？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT i.BillingCountry AS billing_country,ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nGROUP BY i.BillingCountry ORDER BY sales_amount DESC,i.BillingCountry LIMIT 5;", "gold_result": [{"billing_country": "Brazil", "sales_amount": 28.71}, {"billing_country": "Canada", "sales_amount": 24.75}, {"billing_country": "USA", "sales_amount": 19.8}, {"billing_country": "Netherlands", "sales_amount": 15.84}, {"billing_country": "France", "sales_amount": 8.91}], "gold_calculation": null, "gold_answer": "返回按 Invoice.BillingCountry 汇总的前五个国家及销售额，不使用Customer所在地替代账单国家。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["使用账单国家", "按销售额降序"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度音频销售额最高的五个账单国家是什么？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "basic-nl2sql-011", "level": "basic", "capability": "track_identity_attributes", "question": "TrackId 为 1791 的商品叫什么？属于哪个音乐分类、哪种媒体类型，标价是多少美元？", "data_scope": "music", "expected_tables": ["Track", "Genre", "MediaType"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT t.TrackId,t.Name,g.Name AS genre,mt.Name AS media_type,t.UnitPrice AS unit_price\nFROM Track t JOIN Genre g ON g.GenreId=t.GenreId\nJOIN MediaType mt ON mt.MediaTypeId=t.MediaTypeId\nWHERE t.TrackId=1791;", "gold_result": {"TrackId": 1791, "Name": "Down Under", "genre": "Rock", "media_type": "MPEG audio file", "unit_price": 0.99}, "gold_calculation": null, "gold_answer": "商品 1791：Down Under；音乐分类 Rock；媒体类型 MPEG audio file；标价 0.99 美元。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["精确识别TrackId=1791，不把编号当作年份", "列出名称、音乐分类、媒体类型和标价；标价不是成交销售额"], "clarification_required": false, "clarification_target": null, "difficulty": "easy", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "TrackId 为 1791 的商品叫什么？属于哪个音乐分类、哪种媒体类型，标价是多少美元？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer", "sql_results"], "source_assertions": []}}
{"id": "basic-nl2sql-012", "level": "basic", "capability": "year_month_audio_sales_distinct_orders", "question": "按月份列出 2025 年音频销售额和音频订单数，按月份升序排列。音频订单数按订单去重统计。", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT strftime('%Y-%m',i.InvoiceDate) AS month,\nROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount,\nCOUNT(DISTINCT i.InvoiceId) AS order_count\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId\nJOIN Track t ON t.TrackId=il.TrackId\nWHERE i.InvoiceDate>='2025-01-01' AND i.InvoiceDate<'2026-01-01'\nAND t.MediaTypeId IN (1,2,4,5)\nGROUP BY strftime('%Y-%m',i.InvoiceDate) ORDER BY month ASC;", "gold_result": [{"month": "2025-01", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-02", "sales_amount": 27.72, "order_count": 5}, {"month": "2025-03", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-04", "sales_amount": 33.66, "order_count": 5}, {"month": "2025-05", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-06", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-07", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-08", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-09", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-10", "sales_amount": 37.62, "order_count": 7}, {"month": "2025-11", "sales_amount": 25.74, "order_count": 7}, {"month": "2025-12", "sales_amount": 36.63, "order_count": 6}], "gold_calculation": null, "gold_answer": "2025年逐月音频销售额与去重订单数：2025-01：37.62 美元，7 张订单；2025-02：27.72 美元，5 张订单；2025-03：37.62 美元，7 张订单；2025-04：33.66 美元，5 张订单；2025-05：37.62 美元，7 张订单；2025-06：37.62 美元，7 张订单；2025-07：37.62 美元，7 张订单；2025-08：37.62 美元，7 张订单；2025-09：37.62 美元，7 张订单；2025-10：37.62 美元，7 张订单；2025-11：25.74 美元，7 张订单；2025-12：36.63 美元，6 张订单。按月份升序。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["2025全年左闭右开区间，音频MediaTypeId为1、2、4、5", "返回实际查询的12个月，逐月金额和去重订单数正确", "按月份升序，不能只返回第三季度或全年总额"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "按月份列出 2025 年音频销售额和音频订单数，按月份升序排列。音频订单数按订单去重统计。", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer", "sql_results"], "source_assertions": []}}
{"id": "basic-nl2sql-013", "level": "basic", "capability": "billing_country_genre_media_multiple_measures", "question": "2025 年第三季度，账单国家为美国（USA）的 Rock 音频商品，销售额、销量和订单数分别是多少？订单数按订单去重统计。", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount,\nSUM(il.Quantity) AS units_sold,COUNT(DISTINCT i.InvoiceId) AS order_count\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId\nJOIN Track t ON t.TrackId=il.TrackId\nWHERE i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nAND i.BillingCountry='USA' AND t.GenreId=1 AND t.MediaTypeId IN (1,2,4,5);", "gold_result": {"sales_amount": 0.99, "units_sold": 1, "order_count": 1}, "gold_calculation": null, "gold_answer": "2025Q3账单国家USA的Rock音频商品：销售额 0.99 美元，销量 1 件，去重订单 1 张。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["2025Q3、Invoice.BillingCountry=USA、GenreId=1及音频范围同时生效", "销售额按成交UnitPrice*Quantity、销量按Quantity，订单按InvoiceId去重", "不能用Customer.Country代替账单国家，不并入Rock And Roll"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025 年第三季度，账单国家为美国（USA）的 Rock 音频商品，销售额、销量和订单数分别是多少？订单数按订单去重统计。", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer", "sql_results"], "source_assertions": []}}
{"id": "basic-nl2sql-014", "level": "basic", "capability": "customer_having_threshold_tie_order", "question": "2025 年第三季度，音频消费总额不少于 10 美元的客户有哪些？列出客户编号和消费额，按消费额降序排列，同额按客户编号升序排列。", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT i.CustomerId,ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId\nJOIN Track t ON t.TrackId=il.TrackId\nWHERE i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nAND t.MediaTypeId IN (1,2,4,5)\nGROUP BY i.CustomerId HAVING SUM(il.UnitPrice*il.Quantity)>=10\nORDER BY sales_amount DESC,i.CustomerId ASC;", "gold_result": [{"CustomerId": 10, "sales_amount": 15.84}, {"CustomerId": 48, "sales_amount": 15.84}, {"CustomerId": 31, "sales_amount": 13.86}], "gold_calculation": null, "gold_answer": "2025Q3音频消费总额不少于10美元的客户：客户 10：15.84 美元；客户 48：15.84 美元；客户 31：13.86 美元。消费额降序，同额客户编号升序。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["客户粒度聚合全部音频消费；聚合后筛选SUM>=10，包含阈值边界", "客户编号、金额和完整名单正确", "消费额降序，同额客户编号升序，不允许交换并列客户"], "clarification_required": false, "clarification_target": null, "difficulty": "medium_hard", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025 年第三季度，音频消费总额不少于 10 美元的客户有哪些？列出客户编号和消费额，按消费额降序排列，同额按客户编号升序排列。", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer", "sql_results"], "source_assertions": []}}
{"id": "basic-nl2sql-015", "level": "basic", "capability": "all_media_left_join_zero_sales", "question": "列出数据库中所有媒体类型在 2025 年第三季度的销售额和销量，没有成交的类型也要列出并显示为 0，按媒体类型编号升序排列。", "data_scope": "all_media", "expected_tables": ["MediaType", "Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT mt.MediaTypeId,mt.Name,COALESCE(f.sales_amount,0) AS sales_amount,\nCOALESCE(f.units_sold,0) AS units_sold\nFROM MediaType mt LEFT JOIN (\nSELECT t.MediaTypeId,ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount,\nSUM(il.Quantity) AS units_sold\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId\nJOIN Track t ON t.TrackId=il.TrackId\nWHERE i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nGROUP BY t.MediaTypeId\n) f ON f.MediaTypeId=mt.MediaTypeId ORDER BY mt.MediaTypeId ASC;", "gold_result": [{"MediaTypeId": 1, "Name": "MPEG audio file", "sales_amount": 111.87, "units_sold": 113}, {"MediaTypeId": 2, "Name": "Protected AAC audio file", "sales_amount": 0.99, "units_sold": 1}, {"MediaTypeId": 3, "Name": "Protected MPEG-4 video file", "sales_amount": 0, "units_sold": 0}, {"MediaTypeId": 4, "Name": "Purchased AAC audio file", "sales_amount": 0, "units_sold": 0}, {"MediaTypeId": 5, "Name": "AAC audio file", "sales_amount": 0, "units_sold": 0}], "gold_calculation": null, "gold_answer": "2025Q3全部媒体类型：1 MPEG audio file：111.87 美元，113 件；2 Protected AAC audio file：0.99 美元，1 件；3 Protected MPEG-4 video file：0.00 美元，0 件；4 Purchased AAC audio file：0.00 美元，0 件；5 AAC audio file：0.00 美元，0 件。按媒体类型编号升序，零成交保留。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["全部媒体类型，包括视频，不加音频限制", "日期约束真正参与聚合的成交明细，不能泄漏其他季度金额", "返回全部5种类型；3种无成交类型的金额及销量为数值0，不能是NULL或遗漏", "按MediaTypeId升序，销售额使用成交单价乘数量"], "clarification_required": false, "clarification_target": null, "difficulty": "medium_hard", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "列出数据库中所有媒体类型在 2025 年第三季度的销售额和销量，没有成交的类型也要列出并显示为 0，按媒体类型编号升序排列。", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer", "sql_results"], "source_assertions": []}}

{"id": "prelim-day1-013", "level": "holdout", "capability": "granularity_monthly_rows", "question": "2025年第三季度每个月音频销售额分别是多少？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT strftime('%Y-%m',i.InvoiceDate) AS month, ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nGROUP BY month ORDER BY month;", "gold_result": [{"month": "2025-07", "sales_amount": 37.62}, {"month": "2025-08", "sales_amount": 37.62}, {"month": "2025-09", "sales_amount": 37.62}], "gold_calculation": null, "gold_answer": "7月、8月、9月的音频销售额分别为37.62、37.62、37.62美元，按月三行列示。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["三行按月结果", "不得只给季度合计一行"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "holdout", "modality": "text", "requirements": {"group": "granularity_safety", "accepted_statuses": ["answered"], "min_rows": 3, "required_values": [37.62], "requires_month_grouping": true}, "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度每个月音频销售额分别是多少？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "prelim-day1-014", "level": "holdout", "capability": "granularity_running_total", "question": "2025年第三季度每个月销售额累计到当月是多少？", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "WITH monthly AS (SELECT strftime('%Y-%m',i.InvoiceDate) AS month,\n  ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount\n  FROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\n  WHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\n  GROUP BY month)\nSELECT month, ROUND(SUM(sales_amount) OVER (ORDER BY month),2) AS sales_amount\nFROM monthly ORDER BY month;", "gold_result": [{"month": "2025-07", "sales_amount": 37.62}, {"month": "2025-08", "sales_amount": 75.24}, {"month": "2025-09", "sales_amount": 112.86}], "gold_calculation": null, "gold_answer": "累计到7月为37.62美元，累计到8月为75.24美元，累计到9月为112.86美元；此处金额为当月累计值。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["三行月累计", "不得降级为季度单行", "不得用当月值代替累计值"], "clarification_required": false, "clarification_target": null, "difficulty": "hard", "split": "holdout", "modality": "text", "requirements": {"group": "granularity_safety", "accepted_statuses": ["answered"], "min_rows": 3, "required_values": [37.62, 75.24, 112.86], "requires_month_grouping": true, "requires_running_total": true}, "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度每个月销售额累计到当月是多少？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}

{"id": "special-multitable-001", "level": "special", "capability": "track_album_artist_join", "question": "2025年第三季度销售额最高的五个商品，要同时列出专辑和艺术家。", "data_scope": "music", "expected_tables": ["Invoice", "InvoiceLine", "Track", "Album", "Artist"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT t.TrackId,t.Name,al.Title AS album,ar.Name AS artist,ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId JOIN Album al ON al.AlbumId=t.AlbumId JOIN Artist ar ON ar.ArtistId=al.ArtistId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>='2025-07-01' AND i.InvoiceDate<'2025-10-01'\nGROUP BY t.TrackId,t.Name ORDER BY sales_amount DESC,t.TrackId LIMIT 5;", "gold_result": [{"TrackId": 1786, "Name": "Save The Children", "album": "Seek And Shall Find: More Of The Best (1963-1981)", "artist": "Marvin Gaye", "sales_amount": 0.99}, {"TrackId": 1787, "Name": "You Sure Love To Ball", "album": "Seek And Shall Find: More Of The Best (1963-1981)", "artist": "Marvin Gaye", "sales_amount": 0.99}, {"TrackId": 1789, "Name": "Praise", "album": "Seek And Shall Find: More Of The Best (1963-1981)", "artist": "Marvin Gaye", "sales_amount": 0.99}, {"TrackId": 1791, "Name": "Down Under", "album": "The Best Of Men At Work", "artist": "Men At Work", "sales_amount": 0.99}, {"TrackId": 1793, "Name": "Be Good Johnny", "album": "The Best Of Men At Work", "artist": "Men At Work", "sales_amount": 0.99}], "gold_calculation": null, "gold_answer": "按TrackId汇总并连接Album、Artist，返回商品、专辑、艺术家和销售额。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["多表连接正确", "保留商品身份字段"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度销售额最高的五个商品，要同时列出专辑和艺术家。", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}

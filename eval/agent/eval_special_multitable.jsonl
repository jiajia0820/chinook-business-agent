{"id": "special-multitable-004", "level": "special", "capability": "playlist_track_join", "question": "每个播放列表收录了多少个不同商品？", "data_scope": "all_media", "expected_tables": ["Playlist", "PlaylistTrack", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT p.PlaylistId,p.Name,COUNT(DISTINCT pt.TrackId) AS track_count FROM Playlist p JOIN PlaylistTrack pt ON pt.PlaylistId=p.PlaylistId GROUP BY p.PlaylistId,p.Name ORDER BY p.PlaylistId;", "gold_result": [{"PlaylistId": 1, "Name": "Music", "track_count": 3290}, {"PlaylistId": 3, "Name": "TV Shows", "track_count": 213}, {"PlaylistId": 5, "Name": "90’s Music", "track_count": 1477}, {"PlaylistId": 8, "Name": "Music", "track_count": 3290}, {"PlaylistId": 9, "Name": "Music Videos", "track_count": 1}, {"PlaylistId": 10, "Name": "TV Shows", "track_count": 213}, {"PlaylistId": 11, "Name": "Brazilian Music", "track_count": 39}, {"PlaylistId": 12, "Name": "Classical", "track_count": 75}, {"PlaylistId": 13, "Name": "Classical 101 - Deep Cuts", "track_count": 25}, {"PlaylistId": 14, "Name": "Classical 101 - Next Steps", "track_count": 25}, {"PlaylistId": 15, "Name": "Classical 101 - The Basics", "track_count": 25}, {"PlaylistId": 16, "Name": "Grunge", "track_count": 15}, {"PlaylistId": 17, "Name": "Heavy Metal Classic", "track_count": 26}, {"PlaylistId": 18, "Name": "On-The-Go 1", "track_count": 1}], "gold_calculation": null, "gold_answer": "通过PlaylistTrack按PlaylistId统计去重后的TrackId数量；这只是收录数量，不是播放量。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["TrackId去重", "不声称播放量"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "每个播放列表收录了多少个不同商品？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id": "special-multitable-005", "level": "special", "capability": "customer_sales_join", "question": "2025年第三季度购买音频金额最高的五位客户是谁？", "data_scope": "music", "expected_tables": ["Invoice", "Customer", "InvoiceLine", "Track"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT i.CustomerId,c.FirstName||' '||c.LastName AS customer,ROUND(SUM(il.UnitPrice*il.Quantity),2) AS sales_amount,COUNT(DISTINCT i.InvoiceId) AS order_count\nFROM Invoice i JOIN Customer c ON c.CustomerId=i.CustomerId JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>=? AND i.InvoiceDate<? GROUP BY i.CustomerId,c.FirstName,c.LastName ORDER BY sales_amount DESC,i.CustomerId LIMIT 5;", "gold_result": [{"CustomerId": 10, "customer": "Eduardo Martins", "sales_amount": 15.84, "order_count": 2}, {"CustomerId": 48, "customer": "Johannes Van der Berg", "sales_amount": 15.84, "order_count": 2}, {"CustomerId": 31, "customer": "Martha Silk", "sales_amount": 13.86, "order_count": 1}, {"CustomerId": 1, "customer": "Luís Gonçalves", "sales_amount": 8.91, "order_count": 1}, {"CustomerId": 22, "customer": "Heather Leacock", "sales_amount": 8.91, "order_count": 1}], "gold_calculation": null, "gold_answer": "按CustomerId汇总第三季度音频明细，返回客户编号、客户姓名、销售额和订单数。", "gold_params": ["2025-07-01", "2025-10-01"], "known_conflicts": [], "gold_answer_requirements": ["Customer与Invoice连接正确", "金额按明细计算"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "2025年第三季度购买音频金额最高的五位客户是谁？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}
{"id":"special-multitable-006","level":"special","capability":"support_rep_customer_join","question":"2025年第三季度购买音频客户按支持负责人分布如何？","data_scope":"music","expected_tables":["Employee","Customer","Invoice","InvoiceLine","Track"],"expected_documents":[],"evidence_locations":[],"gold_sql":"SELECT e.FirstName||' '||e.LastName AS support_rep,COUNT(DISTINCT c.CustomerId) AS customer_count\nFROM Employee e JOIN Customer c ON c.SupportRepId=e.EmployeeId JOIN Invoice i ON i.CustomerId=c.CustomerId JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>=? AND i.InvoiceDate<? GROUP BY e.EmployeeId,e.FirstName,e.LastName ORDER BY support_rep;","gold_result":[{"support_rep":"Jane Peacock","customer_count":8},{"support_rep":"Margaret Park","customer_count":6},{"support_rep":"Steve Johnson","customer_count":5}],"gold_calculation":null,"gold_answer":"按SupportRepId统计其负责且在第三季度购买音频的去重客户数；这表示维护分布，不表示个人销售贡献。","gold_params":["2025-07-01","2025-10-01"],"known_conflicts":[],"gold_answer_requirements":["客户去重","不解释为员工销售排名"],"clarification_required":false,"clarification_target":null,"difficulty":"hard","split":"dev","modality":"text","interface_expectation":{"profile_id":"chinook-music","mode":"sql_only","request":{"question":"2025年第三季度购买音频客户按支持负责人分布如何？","profile_id":"chinook-music","user_role":"operator","options":{"show_trace":true,"max_rows":50,"top_k":5}},"expected_status":"answered","expected_route":"sql","required_response_fields":["request_id","session_id","profile_id","status","answer","route","intent","entities","time_range","sql_results","documents","calculations","metric_definitions","limitations","clarification","trace","error"],"required_nonempty_fields":["answer"],"source_assertions":[]}}
{"id":"special-multitable-007","level":"special","capability":"genre_customer_order_join","question":"2025年第三季度各音乐分类的订单数和购买客户数是多少？","data_scope":"music","expected_tables":["Invoice","InvoiceLine","Track","Genre"],"expected_documents":[],"evidence_locations":[],"gold_sql":"SELECT g.Name AS genre,COUNT(DISTINCT i.InvoiceId) AS order_count,COUNT(DISTINCT i.CustomerId) AS customer_count\nFROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId JOIN Genre g ON g.GenreId=t.GenreId\nWHERE t.MediaTypeId IN (1,2,4,5) AND i.InvoiceDate>=? AND i.InvoiceDate<? GROUP BY g.GenreId,g.Name ORDER BY order_count DESC, g.GenreId;","gold_result":[{"genre":"Rock","order_count":14,"customer_count":12},{"genre":"Alternative & Punk","order_count":5,"customer_count":5},{"genre":"Metal","order_count":4,"customer_count":4},{"genre":"Latin","order_count":4,"customer_count":4},{"genre":"Hip Hop/Rap","order_count":3,"customer_count":3},{"genre":"R&B/Soul","order_count":2,"customer_count":2},{"genre":"Jazz","order_count":1,"customer_count":1},{"genre":"Reggae","order_count":1,"customer_count":1},{"genre":"Soundtrack","order_count":1,"customer_count":1},{"genre":"World","order_count":1,"customer_count":1}],"gold_calculation":null,"gold_answer":"按Genre汇总，订单数按InvoiceId去重，购买客户数按CustomerId去重；品类数不能直接相加得到总数。","gold_params":["2025-07-01","2025-10-01"],"known_conflicts":[],"gold_answer_requirements":["两个去重口径正确"],"clarification_required":false,"clarification_target":null,"difficulty":"hard","split":"dev","modality":"text","interface_expectation":{"profile_id":"chinook-music","mode":"sql_only","request":{"question":"2025年第三季度各音乐分类的订单数和购买客户数是多少？","profile_id":"chinook-music","user_role":"operator","options":{"show_trace":true,"max_rows":50,"top_k":5}},"expected_status":"answered","expected_route":"sql","required_response_fields":["request_id","session_id","profile_id","status","answer","route","intent","entities","time_range","sql_results","documents","calculations","metric_definitions","limitations","clarification","trace","error"],"required_nonempty_fields":["answer"],"source_assertions":[]}}
{"id": "special-multitable-008", "level": "special", "capability": "mixed_order_join", "question": "数据库中同时含音频和视频明细的订单有多少张？", "data_scope": "all_media", "expected_tables": ["Invoice", "InvoiceLine", "Track", "MediaType"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT COUNT(DISTINCT i.InvoiceId) AS mixed_order_count FROM Invoice i JOIN InvoiceLine il ON il.InvoiceId=i.InvoiceId JOIN Track t ON t.TrackId=il.TrackId WHERE i.InvoiceId IN (SELECT il2.InvoiceId FROM InvoiceLine il2 JOIN Track t2 ON t2.TrackId=il2.TrackId WHERE t2.MediaTypeId IN (1,2,4,5)) AND i.InvoiceId IN (SELECT il3.InvoiceId FROM InvoiceLine il3 JOIN Track t3 ON t3.TrackId=il3.TrackId WHERE t3.MediaTypeId=3);", "gold_result": {"mixed_order_count": 17}, "gold_calculation": null, "gold_answer": "有17张订单同时含音频和视频明细。计算音乐销售额时仍需按InvoiceLine筛选。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["结果为17", "说明混合订单处理"], "clarification_required": false, "clarification_target": null, "difficulty": "hard", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "chinook-music", "mode": "sql_only", "request": {"question": "数据库中同时含音频和视频明细的订单有多少张？", "profile_id": "chinook-music", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"], "source_assertions": []}}

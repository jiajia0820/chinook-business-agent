{"id": "aw-schema-008", "level": "special", "capability": "category_product_path", "question": "每个产品类别有多少个产品？", "data_scope": "AdventureWorks", "expected_tables": ["Production.ProductCategory", "Production.ProductSubcategory", "Production.Product"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT c.\"ProductCategoryID\" AS category_id, c.\"Name\" AS category_name, COUNT(p.\"ProductID\") AS product_count\nFROM \"Production\".\"ProductCategory\" c JOIN \"Production\".\"ProductSubcategory\" s ON s.\"ProductCategoryID\" = c.\"ProductCategoryID\"\nJOIN \"Production\".\"Product\" p ON p.\"ProductSubcategoryID\" = s.\"ProductSubcategoryID\"\nGROUP BY c.\"ProductCategoryID\", c.\"Name\" ORDER BY c.\"ProductCategoryID\";", "gold_result": [{"category_id": 1, "category_name": "Bikes", "product_count": 97}, {"category_id": 2, "category_name": "Components", "product_count": 134}, {"category_id": 3, "category_name": "Clothing", "product_count": 35}, {"category_id": 4, "category_name": "Accessories", "product_count": 29}], "gold_calculation": null, "gold_answer": "各产品类别的产品数如下：\n1. 类别ID 1，类别 Bikes，产品数 97\n2. 类别ID 2，类别 Components，产品数 134\n3. 类别ID 3，类别 Clothing，产品数 35\n4. 类别ID 4，类别 Accessories，产品数 29", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["正确经过子类别关联产品", "按 ProductID 计数"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "adventureworks", "mode": "sql_only", "request": {"question": "每个产品类别有多少个产品？", "profile_id": "adventureworks", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"
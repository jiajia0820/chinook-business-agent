{"id": "aw-schema-005", "level": "special", "capability": "category_path_linking", "question": "2013年各产品类别的销售额是多少？", "data_scope": "AdventureWorks", "expected_tables": ["Sales.SalesOrderHeader", "Sales.SalesOrderDetail", "Production.Product", "Production.ProductSubcategory", "Production.ProductCategory"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT c.\"ProductCategoryID\" AS category_id, c.\"Name\" AS category_name, ROUND(SUM(d.\"OrderQty\" * d.\"UnitPrice\" * (1 - d.\"UnitPriceDiscount\")), 2) AS sales_amount\nFROM \"Sales\".\"SalesOrderHeader\" h JOIN \"Sales\".\"SalesOrderDetail\" d ON d.\"SalesOrderID\" = h.\"SalesOrderID\"\nJOIN \"Production\".\"Product\" p ON p.\"ProductID\" = d.\"ProductID\"\nJOIN \"Production\".\"ProductSubcategory\" s ON s.\"ProductSubcategoryID\" = p.\"ProductSubcategoryID\"\nJOIN \"Production\".\"ProductCategory\" c ON c.\"ProductCategoryID\" = s.\"ProductCategoryID\"\nWHERE h.\"OrderDate\" >= DATE '2013-01-01' AND h.\"OrderDate\" < DATE '2014-01-01'\nGROUP BY c.\"ProductCategoryID\", c.\"Name\" ORDER BY c.\"ProductCategoryID\";", "gold_result": [{"category_id": 1, "category_name": "Bikes", "sales_amount": 36266829.36}, {"category_id": 2, "category_name": "Components", "sales_amount": 5612935.34}, {"category_id": 3, "category_name": "Clothing", "sales_amount": 1067689.7}, {"category_id": 4, "category_name": "Accessories", "sales_amount": 675024.65}], "gold_calculation": null, "gold_answer": "2013年各产品类别销售额如下（美元）：\n1. 类别ID 1，类别 Bikes，销售额 36,266,829.36\n2. 类别ID 2，类别 Components，销售额 5,612,935.34\n3. 类别ID 3，类别 Clothing，销售额 1,067,689.70\n4. 类别ID 4，类别 Accessories，销售额 675,024.65", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["使用 Product→ProductSubcategory→ProductCategory 路径", "不直接把产品当类别"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "adventureworks", "mode": "sql_only", "request": {"question": "2013年各产品类别的销售额是多少？", "profile_id": "adventureworks", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"]}}

{"id": "aw-schema-001", "level": "special", "capability": "order_date_linking", "question": "2013年按下单日期统计的销售额是多少？", "data_scope": "AdventureWorks", "expected_tables": ["Sales.SalesOrderHeader", "Sales.SalesOrderDetail"], "expected_documents": [], "evidence_locations": [], "gold_sql": "SELECT ROUND(SUM(d.\"OrderQty\" * d.\"UnitPrice\" * (1 - d.\"UnitPriceDiscount\")), 2) AS sales_amount\nFROM \"Sales\".\"SalesOrderHeader\" h JOIN \"Sales\".\"SalesOrderDetail\" d ON d.\"SalesOrderID\" = h.\"SalesOrderID\"\nWHERE h.\"OrderDate\" >= DATE '2013-01-01' AND h.\"OrderDate\" < DATE '2014-01-01';", "gold_result": {"sales_amount": 43622479.05}, "gold_calculation": null, "gold_answer": "按下单日期统计，2013年销售额为43,622,479.05美元。", "gold_params": [], "known_conflicts": [], "gold_answer_requirements": ["使用 SalesOrderHeader.OrderDate", "不使用 DueDate、ShipDate 或 ModifiedDate"], "clarification_required": false, "clarification_target": null, "difficulty": "medium", "split": "dev", "modality": "text", "interface_expectation": {"profile_id": "adventureworks", "mode": "sql_only", "request": {"question": "2013年按下单日期统计的销售额是多少？", "profile_id": "adventureworks", "user_role": "operator", "options": {"show_trace": true, "max_rows": 50, "top_k": 5}}, "expected_status": "answered", "expected_route": "sql", "required_response_fields": ["request_id", "session_id", "profile_id", "status", "answer", "route", "intent", "entities", "time_range", "sql_results", "documents", "calculations", "metric_definitions", "limitations", "clarification", "trace", "error"], "required_nonempty_fields": ["answer"]}}

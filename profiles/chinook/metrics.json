{
  "version": "chinook-business-1",
  "metrics": [
    {"metric_id":"customer_count","name":"客户记录数","definition":"Customer 表记录数，不等于购买客户数；演示口径，尚未由 A 正式确认。","unit":"条","grain":"customer","required_columns":["main.Customer.CustomerId"],"aggregation":"count_rows","required_slots":[],"source_refs":["D01","D12"]},
    {"metric_id":"sales_amount","name":"销售额","definition":"按 InvoiceLine.UnitPrice * InvoiceLine.Quantity 汇总，默认只统计音频媒体，日期采用左闭右开。","unit":"USD","grain":"period_scope","required_columns":["main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity","main.Invoice.InvoiceDate","main.Track.MediaTypeId"],"aggregation":"sum(line.unit_price * line.quantity)","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D12"]},
    {"metric_id":"units_sold","name":"销量","definition":"按 InvoiceLine.Quantity 汇总，单位为件。","unit":"件","grain":"period_scope","required_columns":["main.InvoiceLine.Quantity","main.Invoice.InvoiceDate","main.Track.MediaTypeId"],"aggregation":"sum(line.quantity)","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D12"]},
    {"metric_id":"order_count","name":"订单数","definition":"在筛选范围内按 InvoiceId 去重计数。","unit":"单","grain":"period_scope","required_columns":["main.Invoice.InvoiceId","main.Invoice.InvoiceDate"],"aggregation":"count(distinct invoice.invoice_id)","required_slots":["start_date","end_date"],"source_refs":["D01","D02"]},
    {"metric_id":"purchasing_customers","name":"购买客户数","definition":"在筛选范围内按 Invoice.CustomerId 去重计数。","unit":"人","grain":"period_scope","required_columns":["main.Invoice.CustomerId","main.Invoice.InvoiceDate"],"aggregation":"count(distinct invoice.customer_id)","required_slots":["start_date","end_date"],"source_refs":["D01","D12"]},
    {"metric_id":"average_order_value","name":"客单价","definition":"同一筛选范围内销售额除以订单数，订单数为零时不计算。","unit":"USD/单","grain":"period_scope","required_columns":["main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity","main.Invoice.InvoiceId","main.Invoice.InvoiceDate"],"aggregation":"sales_amount / order_count","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D02"]},
    {"metric_id":"genre_sales","name":"品类销售额","definition":"按 Genre 汇总筛选范围内的销售额，明细按成交单价乘数量。","unit":"USD","grain":"genre","required_columns":["main.Genre.GenreId","main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity","main.Track.GenreId"],"aggregation":"sum(line.unit_price * line.quantity) group by genre","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D03"]},
    {"metric_id":"track_sales","name":"商品销售额","definition":"按 Track 汇总筛选范围内的销售额。","unit":"USD","grain":"track","required_columns":["main.Track.TrackId","main.InvoiceLine.TrackId","main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity"],"aggregation":"sum(line.unit_price * line.quantity) group by track","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D05","D12"]},
    {"metric_id":"album_sales","name":"专辑销售额","definition":"按 Album 汇总筛选范围内的销售额。","unit":"USD","grain":"album","required_columns":["main.Album.AlbumId","main.Track.AlbumId","main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity"],"aggregation":"sum(line.unit_price * line.quantity) group by album","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D12"]},
    {"metric_id":"artist_sales","name":"艺术家销售额","definition":"按 Artist 汇总筛选范围内的销售额。","unit":"USD","grain":"artist","required_columns":["main.Artist.ArtistId","main.Album.ArtistId","main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity"],"aggregation":"sum(line.unit_price * line.quantity) group by artist","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D12"]},
    {"metric_id":"media_type_sales","name":"媒体类型销售额","definition":"按 MediaType 汇总筛选范围内的销售额，用于区分音频与视频。","unit":"USD","grain":"media_type","required_columns":["main.MediaType.MediaTypeId","main.Track.MediaTypeId","main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity"],"aggregation":"sum(line.unit_price * line.quantity) group by media_type","required_slots":["start_date","end_date"],"source_refs":["D01","D03"]},
    {"metric_id":"billing_country_sales","name":"账单国家销售额","definition":"按 Invoice.BillingCountry 汇总销售额，地区口径使用账单国家。","unit":"USD","grain":"billing_country","required_columns":["main.Invoice.BillingCountry","main.InvoiceLine.UnitPrice","main.InvoiceLine.Quantity","main.Invoice.InvoiceDate"],"aggregation":"sum(line.unit_price * line.quantity) group by billing_country","required_slots":["start_date","end_date","media_ids"],"source_refs":["D01","D02"]},
    {"metric_id":"playlist_track_count","name":"播放列表商品数","definition":"按 PlaylistTrack 统计播放列表收录的去重 Track 数；不是播放量或销售额。","unit":"件","grain":"playlist","required_columns":["main.PlaylistTrack.PlaylistId","main.PlaylistTrack.TrackId"],"aggregation":"count(distinct playlist_track.track_id)","required_slots":["playlist_id"],"source_refs":["D03","D12"]}
  ]
}

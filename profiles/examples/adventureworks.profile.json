{
  "profile_id": "adventureworks", "mode": "sql_only", "config_version": "1",
  "database": {
    "dialect": "postgresql", "url_env": "ADVENTUREWORKS_DATABASE_URL",
    "display_name": "AdventureWorks PostgreSQL", "allowed_schemas": ["Production", "Sales"],
    "allowed_tables": ["Production.Product", "Production.ProductCategory", "Production.ProductSubcategory", "Sales.Customer", "Sales.SalesOrderDetail", "Sales.SalesOrderHeader"],
    "connect_timeout_seconds": 5, "metadata_timeout_ms": 10000
  },
  "catalog_files": {"metrics": "metrics.json"},
  "slots": {"start_date": {"type": "string"}, "end_date": {"type": "string"}},
  "policy": {"max_rows": 200, "query_timeout_ms": 10000}
}

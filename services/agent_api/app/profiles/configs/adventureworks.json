    {
      "metric_id": "sales_amount",
      "name": "销售额",
      "definition": "按 SalesOrderDetail.OrderQty * UnitPrice * (1 - UnitPriceDiscount) 汇总销售订单明细；日期使用 SalesOrderHeader.OrderDate。",
      "unit": "USD",
      "source_refs": [
        "AW.CATALOG"
      ]
    },
    {
      "metric_id": "units_sold",
      "name": "销量",
      "definition": "按 SalesOrderDetail.OrderQty 汇总销售数量；日期使用 SalesOrderHeader.OrderDate。",
      "unit": "件",
      "source_refs": [
        "AW.CATALOG"
      ]
    },
    {
      "metric_id": "order_count",
      "name": "订单数",
      "definition": "按 SalesOrderHeader.SalesOrderID 去重计数。",
      "unit": "单",
      "source_refs": [
        "AW.CATALOG"
      ]
    },
    {
      "metric_id": "customer_count",
      "name": "客户数",
      "definition": "Sales.Customer 表中的客户记录数。",
      "unit": "人",
      "source_refs": [
        "AW.CATALOG"
      ]
    },
    {
      "metric_id": "product_sales",
      "name": "产品销售额",
      "definition": "按 Production.Product 汇总关联销售订单明细的 OrderQty * UnitPrice * (1 - UnitPriceDiscount)。",
      "unit": "USD",
      "source_refs": [
        "AW.CATALOG"
      ]
    }
  ],

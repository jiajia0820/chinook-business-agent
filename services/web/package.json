{
  "name": "chinook-business-agent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": { "node": "^22.13.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "contracts:sync": "node scripts/sync-contract.mjs",
    "contracts:check": "node scripts/sync-contract.mjs --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/check-boundaries.mjs",
    "verify": "npm run contracts:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.4.6",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
